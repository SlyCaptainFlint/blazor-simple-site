{
  "$schema": "backend/photos-worker/node_modules/wrangler/config-schema.json",
  "name": "ozinoveva-photos",
  "main": "backend/photos-worker/src/index.ts",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "ALLOWED_ORIGIN": "" },
  "observability": { "enabled": false },
  "env": {
    "staging": {
      "name": "ozinoveva-photos-staging",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "vars": { "ALLOWED_ORIGIN": "" }
    }
  }
}
